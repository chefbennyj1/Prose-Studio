<%- include('../shared/main', {
    title: 'Login',
    bodyClass: 'login-page-shell',
    body: `
        <main id="main-content">
            <section id="login" class="active"></section>
        </main>
    `,
    extraScripts: `
        <script type="module">
            import { loadSection } from "/services/public/PageManager.js";
            import { loadCSS } from "/libs/Utility.js";
            import { init as initLoginPage } from "/views/auth/login.js";

            (async () => {
                // Same theme the studio opens on, so login and the dashboard
                // are visibly the same application.
                document.documentElement.setAttribute('data-theme', 'light');
                localStorage.setItem('glass-theme', 'light');

                await loadCSS('/views/dashboard/ui-kit/glass-system/glass_components.css');
                await loadCSS('/views/shared/styles/auth-glass.css');
                await loadSection('login', '/views/auth/login.html');
                initLoginPage();
            })();
        </script>
    `
}) %>
